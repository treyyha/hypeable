{
  "name": "hypeable",
  "description": "worth the hype. A free, open-source AI app builder.",
  "homepage": "https://hypeable.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/treyyha/hypeable.git"
  },
  "bugs": {
    "url": "https://github.com/treyyha/hypeable/issues"
  },
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0",
  "author": {
    "name": "Hypeable"
  },
  "scripts": {
    "deploy": "pnpm run build && wrangler deploy",
    "build": "react-router build",
    "dev": "node pre-start.cjs  && react-router dev --host ::",
    "test": "vitest --run",
    "test:related": "node scripts/test-related.mjs",
    "test:watch": "vitest",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:perf": "vitest --run tests/performance",
    "test:coverage": "vitest --run --coverage",
    "e2e": "playwright test --config=playwright.config.ts",
    "e2e:hosted": "playwright test --config=playwright.config.hosted.ts",
    "smoke:live": "node scripts/smoke-live.mjs",
    "e2e:preview": "playwright test --config=playwright.config.preview-smoke.ts",
    "test:e2e": "playwright test --config=playwright.config.e2e.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.e2e.ts --ui",
    "test:e2e:headed": "playwright test --config=playwright.config.e2e.ts --headed",
    "test:e2e:debug": "playwright test --config=playwright.config.e2e.ts --debug",
    "test:e2e:report": "playwright show-report",
    "benchmarks": "vitest bench",
    "benchmarks:watch": "vitest bench --watch",
    "perf:test": "vitest --run tests/performance",
    "perf:analyze": "node scripts/analyze-bundle.js",
    "perf:check": "node scripts/check-performance-budgets.js",
    "perf:report": "pnpm run perf:test && pnpm run perf:analyze",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint app",
    "lint:fix": "npm run lint -- --fix && prettier app --write",
    "start": "vite preview --host :: --port 5173 --strictPort",
    "dockerstart": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "dockerrun": "docker run -it -d --name bolt-ai-live -p 5173:5173 --env-file .env.local bolt-ai",
    "dockerbuild:prod": "docker build -t bolt-ai:production -t bolt-ai:latest --target bolt-ai-production .",
    "dockerbuild": "docker build -t bolt-ai:development -t bolt-ai:latest --target development .",
    "typecheck": "node scripts/typecheck.mjs",
    "update:ripgrep-wasm": "node scripts/update-ripgrep-wasm.mjs",
    "typegen": "wrangler types",
    "preview": "pnpm run build && pnpm run start",
    "prepare": "husky",
    "clean": "node scripts/clean.js",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:dev:inspect": "NODE_ENV=development electron --inspect=9229 build/electron/main/index.mjs",
    "electron:build:deps": "concurrently \"pnpm electron:build:main\" \"pnpm electron:build:preload\" --kill-others-on-fail",
    "electron:build:main": "vite build --config ./electron/main/vite.config.ts",
    "electron:build:preload": "vite build --config ./electron/preload/vite.config.ts",
    "electron:build:renderer": "react-router build --config vite-electron.config.ts",
    "electron:build:unpack": "rimraf dist && pnpm electron:build:renderer && pnpm electron:build:deps && electron-builder --dir",
    "electron:build:mac": "rimraf dist && pnpm electron:build:renderer && pnpm electron:build:deps && electron-builder --mac",
    "electron:build:win": "rimraf dist && pnpm electron:build:renderer && pnpm electron:build:deps && electron-builder --win",
    "electron:build:linux": "rimraf dist && pnpm electron:build:renderer && pnpm electron:build:deps && electron-builder --linux",
    "electron:build:dist": "rimraf dist && pnpm electron:build:renderer && pnpm electron:build:deps && electron-builder --mwl",
    "setup": "node scripts/setup.mjs",
    "ship": "node scripts/ship.mjs",
    "finish": "node scripts/finish.mjs",
    "secrets": "node scripts/secret-scan.mjs --all"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.9"
  },
