{
  "version": 1,
  "patterns": [
    {
      "id": "anthropic",
      "label": "Anthropic API key",
      "source": "sk-ant-[A-Za-z0-9_-]{20,}",
      "flags": ""
    },
    {
      "id": "openai",
      "label": "OpenAI-style key",
      "source": "\\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}",
      "flags": ""
    },
    {
      "id": "openrouter",
      "label": "OpenRouter key",
      "source": "sk-or-v1-[A-Za-z0-9]{20,}",
      "flags": ""
    },
    {
      "id": "github",
      "label": "GitHub token",
      "source": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}",
      "flags": ""
    },
    {
      "id": "aws",
      "label": "AWS access key",
      "source": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "flags": ""
    },
    {
      "id": "google",
      "label": "Google API key",
      "source": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "flags": ""
    },
    {
      "id": "slack",
      "label": "Slack token",
      "source": "\\bxox[abprs]-[A-Za-z0-9-]{10,}",
      "flags": ""
    },
    {
      "id": "stripe",
      "label": "Stripe key",
      "source": "\\b[sr]k_(?:live|test)_[A-Za-z0-9]{16,}",
      "flags": ""
    },
    {
      "id": "vercel",
      "label": "Vercel token",
      "source": "\\b(?:vercel_|vcp_)[A-Za-z0-9]{20,}",
      "flags": ""
    },
    {
      "id": "private-key",
      "label": "Private key block",
      "source": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----",
      "flags": ""
    },
    {
      "id": "jwt",
      "label": "JWT",
      "source": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
      "flags": ""
    },
    {
      "id": "hardcoded-assignment",
      "label": "Hardcoded secret assignment",
      "source": "\\b(?:api[_-]?key|secret|token|password|passwd)\\b['\"]?\\s*[:=]\\s*['\"][A-Za-z0-9_\\-/+=]{20,}['\"]",
      "flags": "i"
    }
  ]
}
