{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker + static assets. The Vite Cloudflare plugin emits assets.directory
  // as build/client. Do not put secrets, API keys, or tokens in this file.
  "name": "hypeable",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domain only. Check deploys on hypeable.dev or with `wrangler tail`.
  "workers_dev": false,
  "preview_urls": false,
  // Invocation logs can capture request metadata; the BYO key travels in a header.
  "observability": {
    "enabled": false,
    "traces": {
      "enabled": false
    },
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    }
  },
  "upload_source_maps": true,
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
